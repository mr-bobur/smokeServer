PORT=5000
NODE_ENV=development

# MySQL 8.0+ Partitioned Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_building_ecosystem

# MQTT over TLS / Central Gateway Broker
MQTT_BROKER_URL=mqtt://127.0.0.1:1883

# Google OAuth 2.0 & JWT Security
JWT_SECRET=smart-building-enterprise-jwt-secret-2026
GOOGLE_CLIENT_ID=smart-building-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=smart-building-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
CLIENT_URL=http://localhost:3000

# 112 State Emergency API Dispatcher
EMERGENCY_112_API_URL=https://api.112.gov.uz/v1/emergency/dispatch
EMERGENCY_112_TOKEN=uz-fvv-112-production-bearer-token
